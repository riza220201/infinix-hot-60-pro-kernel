# ── KernelSU-Next ("Wild", pershoot) + SusFS — ksunext variant ────────────────────
# Ported from itel-rs4-kernel/config/ksunext.fragment. SusFS is IN-DRIVER on
# pershoot's susfs branches, so there is no `10_enable_susfs_for_ksu.patch` step —
# that patch is for stock KernelSU and fails 20+ hunks against this tree (measured
# on both KSU-Next v3.4.0 and v3.3.0 before the right method was found).
#
# ⚠ The exact KSU commit, its version anchor, and the SusFS commit are pinned in
#   sources.lock; apply-ksunext-susfs.sh DIES on drift rather than silently shipping
#   a different driver than the one that was gated.
#
# Hooking: KSU depends on KPROBES || SUSFS. Verify KPROBES on this tree before
# trusting the default — 6.12 GKI is not 5.10.
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y

# The vanilla tweaks ride along — a root build should not be a worse kernel.
# build.sh composes vanilla_defconfig + this file + the generated brand block, so
# nothing from vanilla is copied here by hand — a hand copy is one edit away from drift.
