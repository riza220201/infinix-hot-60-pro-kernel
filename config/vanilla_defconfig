# config/vanilla_defconfig — KMI-safe tweaks on top of stock gki_defconfig.
#
# Applied by kleaf as a POST-defconfig fragment (--defconfig_fragment), i.e.
# after `make gki_defconfig`, followed by `olddefconfig`. Kleaf then ENFORCES
# that every line here survived — which is the guard the itel RS4 project did
# not have when `CONFIG_ZRAM=y` sat in a fragment for a whole release while
# being silently dropped (its ZSMALLOC dependency was unmet, so olddefconfig
# discarded it and nobody noticed until ZRAM was accidentally switched ON).
#
# ⚠ EVERY LINE HERE IS UNPROVEN UNTIL A BUILD GATES IT. Build --stock FIRST so
# the gate measures the SOURCE BRANCH alone; only then add this fragment and
# re-gate, so a failure has one possible cause instead of two.

# ── Default queue discipline: fq ───────────────────────────────────────────
# gki_defconfig already builds sch_fq but leaves the default at pfifo_fast. BBR
# (enabled below) is designed to pair with fq, which does the pacing and
# per-flow isolation BBR relies on.
# 🪤 The choice is gated behind `menuconfig NET_SCH_DEFAULT` (net/sched/Kconfig
# :406) — setting DEFAULT_FQ alone is invisible to Kconfig and silently drops.
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# ── TTL / hop-limit targets ────────────────────────────────────────────────
# Lets a ROM normalise TTL for tethering. Leaf netfilter targets: no core struct
# is touched, so they cannot move a CRC.
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y

# ── TCP congestion control: BBR as default (MODIFICATIONS §B) ──────────────
# ✏️ CORRECTED 2026-10-01. Earlier text here said gki_defconfig "already sets
#   CONFIG_TCP_CONG_BBR=y" and TCP_CONG_ADVANCED. That was measured on the
#   android16-6.12-LTS branch (6.12.93); the branch we actually build,
#   android16-6.12-2025-09 (6.12.38), has NEITHER — v1 shipped fq without BBR.
# 🪤 TCP_CONG_ADVANCED is a menuconfig gate; opening it flips BIC, WESTWOOD and
#   HTCP to their Kconfig default of =m, and an unlisted =m makes kleaf refuse
#   the build. So every option behind the gate is pinned explicitly here.
#   Leaf CC modules register through tcp_register_congestion_control(): no core
#   struct changes, nothing the vendor modules import moves.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_TCP_CONG_VEGAS=y
# CONFIG_TCP_CONG_BIC is not set
CONFIG_DEFAULT_BBR=y

# ── CAKE qdisc (MODIFICATIONS §B) ─────────────────────────────────────────
# Modern AQM, selectable at runtime with tc; the default stays fq (above).
CONFIG_NET_SCH_CAKE=y

# ── Source patches (apply-mods.sh, patches/series) ──────────────────────────
# Each switch below is backed by a patch in patches/; the gate re-verifies the
# KMI, and build.sh asserts each one survived into the final .config.
# BORE 6.8.0 — burst-aware CFS/EEVDF tweak. Its per-task state is packed into
#   task_struct's ANDROID_KABI_RESERVE slots 3..6 (see patches/). Runtime off
#   switch, no reflash needed:  echo 0 > /proc/sys/kernel/sched_bore
CONFIG_SCHED_BORE=y
# ntsync — the COMPLETE mainline driver (the in-tree 6.12 file is the 247-line,
#   semaphore-only stub behind `depends on BROKEN`). Leaf misc device, /dev/ntsync.
CONFIG_NTSYNC=y
# Reflex cpufreq governor — built in (its Kconfig default is =m, which kleaf would
#   refuse as an unlisted module). Present but NOT selected: this ROM does not write
#   it anywhere; pick it per policy at runtime via scaling_governor.
CONFIG_CPU_FREQ_GOV_REFLEX=y
# mt6789_balance (MODIFICATIONS §G) — boot boost, touch floor, screen-off cap as
#   freq_qos requests. Tunables: /sys/module/mt6789_balance/parameters/
CONFIG_MT6789_BALANCE=y
# ADIOS I/O scheduler (§D2) — selectable per device; the DEFAULT stays mq-deadline
#   (single-queue UFS, §F/§G: do not change the default the tester relies on).
CONFIG_MQ_IOSCHED_ADIOS=y
# CONFIG_MQ_IOSCHED_DEFAULT_ADIOS is not set
# Kcompressd-Unofficial (§D2) — kswapd hands zram-bound anon folios to a per-node
#   kthread. Runtime: vm.kcompressd (queue depth, 0 = off).
CONFIG_KCOMPRESSD=y
# le9uo (§D2) has no Kconfig switch; it is compiled in DORMANT
#   (vm.workingset_protection=0). Its ratio defaults come from its own Kconfig.

# ── NOT set here, on purpose ───────────────────────────────────────────────
# CONFIG_ZRAM stays =m. gki_defconfig already ships it as a MODULE, which is the
#   right answer anyway: on the itel RS4 a built-in ZRAM bricked recovery,
#   because that device had no dedicated recovery partition and recovery shared
#   boot's kernel. Whether THIS device shares that layout is still unmeasured
#   (tools/device-probe.sh answers it) — so the conclusion is not carried over,
#   and neither is the fix. =m needs no decision.
#
# CONFIG_CRYPTO_LZ4HC — NOT taken, though MODIFICATIONS §B listed it. On 6.12 zram
#   no longer uses the crypto API: it compiles its own backends (ZRAM_BACKEND_*)
#   into zram.ko, and this device loads zram.ko from the ROM's system_dlkm (it is
#   in neither vendor set), built by Google. Nothing we set here reaches it.
#
# CONFIG_LOCALVERSION is NOT set here. build.sh generates it from device.conf's
#   BRAND for every variant ("-$BRAND-<variant>"), so the brand has exactly one
#   source of truth and a fragment can never disagree with the package check.
