# build work dir + outputs (large, reproducible)
.build/
out/

# stock firmware images pulled off the device — OEM firmware, not ours to
# redistribute, and the tooling regenerates everything under .build/ from them
*.img

# reference material dropped in the tree
*.zip
*.log
Screenshot*

# AnyKernel3 vendored copy keeps its files but not its git metadata
anykernel/.git/

# Markdown is local work notes (journal, resume, inventory, release drafts) —
# only READMEs are part of the repo.
*.md
!README.md

# python caches
__pycache__/
*.pyc
