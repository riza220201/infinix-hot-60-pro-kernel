diff --git a/mm/swap.h b/mm/swap.h
index ad2f121de..2b0783b45 100644
--- a/mm/swap.h
+++ b/mm/swap.h
@@ -21,6 +21,28 @@ static inline void swap_read_unplug(struct swap_iocb *plug)
 void swap_write_unplug(struct swap_iocb *sio);
