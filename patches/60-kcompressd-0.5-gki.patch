+#ifdef CONFIG_KCOMPRESSD
+/* Start this node's kcompressd (state in mm/swap.h's side table, not pgdat). */
+static int __meminit kcompressd_start(pg_data_t *pgdat, int nid)
+{
+	struct kcompressd_node *kcd = kcompressd_of(pgdat);
+	int ret;
+
+	if (kcd->task)
+		return 0;
+	ret = kfifo_alloc(&kcd->fifo, KCOMPRESS_FIFO_SIZE * sizeof(struct folio *),
+			  GFP_KERNEL);
+	if (ret) {
+		pr_err("%s: fail to kfifo_alloc\n", __func__);
+		return ret;
+	}
+	init_waitqueue_head(&kcd->wait);
+	spin_lock_init(&kcd->fifo_lock);
+	pr_info("Kcompressd-Unofficial 0.5 by Masahito Suzuki (forked from Kcompressd by Qun-Wei Lin from MediaTek)\n");
+	kcd->task = kthread_create_on_node(kcompressd, pgdat, nid, "kcompressd%d", nid);
+	if (IS_ERR(kcd->task)) {
+		ret = PTR_ERR(kcd->task);
+		pr_err("Failed to start kcompressd on node %d, ret=%d\n", nid, ret);
+		kcd->task = NULL;
+		kfifo_free(&kcd->fifo);
+		return ret;
+	}
+	wake_up_process(kcd->task);
+	return 0;
+}
+#endif
+
 /*
