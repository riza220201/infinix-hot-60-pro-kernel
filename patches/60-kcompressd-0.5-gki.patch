 void __swap_writepage(struct folio *folio, struct writeback_control *wbc);
+#ifdef CONFIG_KCOMPRESSD
+#include <linux/kfifo.h>
+/*
+ * GKI KMI: upstream Kcompressd-Unofficial keeps this per-node state inside
+ * struct pglist_data. pglist_data is reachable from a large share of what the
+ * vendor modules import (struct zone -> zone_pgdat ...) and has a single 8-byte
+ * KABI slot, so growing it would refuse every vendor module. The state lives
+ * in this side table instead, indexed by node id; pglist_data is untouched.
+ */
+struct kcompressd_node {
+	wait_queue_head_t	wait;
+	struct task_struct	*task;
+	struct kfifo		fifo;
+	spinlock_t		fifo_lock;
+};
+extern struct kcompressd_node kcompressd_nodes[MAX_NUMNODES];
+static inline struct kcompressd_node *kcompressd_of(pg_data_t *pgdat)
+{
+	return &kcompressd_nodes[pgdat->node_id];
+}
+int kcompressd(void *p);
+#endif
 
